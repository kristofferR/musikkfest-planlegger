# Copy to scripts/deploy.env (gitignored) and fill in. Environment variables override these.
# SSH destination (user@host or an alias from ~/.ssh/config).
MUSIKKFEST_DEPLOY_HOST=${MUSIKKFEST_DEPLOY_HOST:-user@server}
# Web folder that is served as https://suboktav.no/musikkfest/
MUSIKKFEST_DEPLOY_TARGET=${MUSIKKFEST_DEPLOY_TARGET:-/path/to/www/musikkfest/}
# Server folder for saved lists, outside the web root. It must match the app's MUSIKKFEST_STORAGE_DIR.
# Leave empty to use <account>/.musikkfest-lister next to an htdocs/ layout.
MUSIKKFEST_STORAGE_DIR=${MUSIKKFEST_STORAGE_DIR:-/path/to/data/musikkfest}
